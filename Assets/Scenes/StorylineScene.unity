  - {fileID: -5637412963110131733, guid: 6e4b436f10623b54cabfa8a40e7054ee, type: 3}
  - {fileID: -5637412963110131733, guid: 6e4b436f10623b54cabfa8a40e7054ee, type: 3}
  - {fileID: 3987673702546802249, guid: b4e3fcec218e39c47a068c4f6b45c794, type: 3}
  - {fileID: 3987673702546802249, guid: b4e3fcec218e39c47a068c4f6b45c794, type: 3}
  - {fileID: 3987673702546802249, guid: b4e3fcec218e39c47a068c4f6b45c794, type: 3}
  - {fileID: 1423519547335621940, guid: 71228705e8275ac4b87ec68b53d0f864, type: 3}
  - {fileID: 1423519547335621940, guid: 71228705e8275ac4b87ec68b53d0f864, type: 3}
  characterAnchors:
  - {x: 0.459, y: 0.37}
  - {x: 0.459, y: 0.37}
  - {x: 0.74, y: 0.43}
  - {x: 0.5, y: 0.32}
  - {x: 0.5, y: 0.32}
